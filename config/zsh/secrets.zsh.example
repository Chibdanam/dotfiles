# Template for machine-local secrets — copy, don't edit this file with real values.
#
# Real secrets must NEVER live in the dotfiles repo. On each machine:
#
#   cp config/zsh/secrets.zsh.example ~/.config/zsh/.secrets.zsh
#   chmod 600 ~/.config/zsh/.secrets.zsh
#   $EDITOR ~/.config/zsh/.secrets.zsh      # fill in real values
#
# ~/.zshenv auto-sources ~/.config/zsh/.secrets.zsh on every shell if present.
# The leading dot keeps the real file out of the .zshrc "*.zsh" auto-source
# glob (so it loads once, from .zshenv, for ALL shells) and out of the dotfiles
# sync, which only copies tracked "*.zsh" files.

# export FIGMA_TOKEN="figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
