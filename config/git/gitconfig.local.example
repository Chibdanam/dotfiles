# Machine-specific git config — not versioned, included from ~/.gitconfig.
# Seeded on first install, then never overwritten. Identity and the gh
# credential helpers are filled in by scripts/modules/git.sh; refresh them
# by hand with `git-local gh auth setup-git`.
[user]
	name =
	email =

# Identity applied per-repo by the `git-personal` / `gsp` shell function
# (config/zsh/functions.zsh) — for personal repos on a work machine, or the
# other way around. Leave empty if this machine has a single identity.
# [personal]
# 	name =
# 	email =
