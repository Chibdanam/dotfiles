[alias]
  st = status
  ck = checkout
  lg = log --all --decorate --oneline --graph
  amend = commit --amend --no-edit
  undo = reset --soft HEAD~1
  wip = !git add -A && git commit -m "WIP"
  defaultBranch = !git remote show origin | sed -n '/HEAD branch/s/.*: //p'
[core]
  editor = nvim
  pager = delta
  autocrlf = input
  excludesfile = ~/.gitignore
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  side-by-side = true
[pull]
  rebase = false
[merge]
  tool = nvimdiff
  conflictstyle = diff3
[diff]
  colorMoved = default
  tool = nvimdiff
  guitool = nvimdiff
[mergetool]
  keepBackup = false
  trustExitCode = false
  prompt = true
[difftool]
  prompt = false
[mergetool "nvimdiff"]
  layout = "LOCAL,BASE,REMOTE / MERGED"
# Identity and credential helpers: per machine, seeded by scripts/modules/git.sh
[include]
	path = ~/.gitconfig.local
